# Local-development settings. These are NOT production hosting configuration.
WOTLK_AUTH_HOST=127.0.0.1
WOTLK_AUTH_PORT=3724
WOTLK_WORLD_HOST=127.0.0.1
WOTLK_WORLD_PORT=8085
# OFF until you have a compatible, lawful client and server for development.
WOTLK_ENABLE_GATEWAY=false
WOTLK_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
WOTLK_MAX_CONNECTIONS=20
